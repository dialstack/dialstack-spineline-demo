{
  "name": "dialstack-spineline-demo",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "FORCE_COLOR=1 next dev 2>&1 | pino-pretty -c -i pid,hostname -t HH:MM:ss",
    "build": "next build",
    "start": "next start",
    "start:migrate": "node scripts/migrate.mjs && next start",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:up": "node --env-file=.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file=.env scripts/migrate.mjs down",
    "migrate:create": "node-pg-migrate create",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "npm run format && npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dialstack/sdk-js": "*",
    "@dialstack/sdk-react": "*",
    "@dialstack/sdk-server": "*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "libphonenumber-js": "^1.13.13",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.25",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
