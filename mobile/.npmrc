# react-native-webrtc / peer ranges across the RN toolchain don't all overlap
# cleanly; accept the resolution rather than block install.
legacy-peer-deps=true

# Note what is deliberately NOT here: ignore-scripts. This app's `postinstall` runs
# patch-package, and the expo-callkit-telecom patch it applies is native Kotlin the
# example depends on — suppressing it leaves the patched code silently absent, and
# the call fails at runtime rather than at install.
