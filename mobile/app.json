{
  "expo": {
    "name": "Spineline",
    "slug": "spineline-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spineline",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.dialstack.spineline.demo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs the microphone to place and receive calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.dialstack.spineline.demo",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "incomingCallTimeout": 300,
          "androidEventReceiver": "ai.dialstack.spineline.demo.WakeEventReceiver",
          "sounds": ["./assets/sounds/ringback.wav"],
          "defaultDialtone": "ringback.wav"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0077b6"
        }
      ],
      "./plugins/withWakeHeadlessService",
      "./plugins/withLocalRigCleartext",
      "./plugins/withCallKitIcon",
      "./plugins/withBrandedIncomingCall"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
