# Copy to .env.local (gitignored) and fill in. Metro inlines these into the app.

# The Spineline backend (a tunnel to your local `npm run dev` in spineline/). The
# app signs in here and reads patients and appointments from it.
EXPO_PUBLIC_SPINELINE_URL=https://replace-me.example

# The click-to-call rig from sdk/examples/mobile/click-to-call, run against the
# practice's DialStack account. 10.0.2.2 is the host loopback as seen from the
# Android emulator; on a device use `adb reverse tcp:8788 tcp:8788` and
# http://127.0.0.1:8788.
EXPO_PUBLIC_RIG_URL=http://10.0.2.2:8788
